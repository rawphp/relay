# relay configuration — generated by install.sh
# Edit this file to customize your setup.
# Paths support ~ expansion (~/foo expands to $HOME/foo)

# ── Agent Identity ───────────────────────────────────────────────────── #
agent_name = {{AGENT_NAME}}
user_name = {{USER_NAME}}

# ── Telegram ────────────────────────────────────────────────────────── #
telegram_bot_token = {{TELEGRAM_TOKEN}}
telegram_user_id = {{TELEGRAM_USER_ID}}

# ── LLM Provider ───────────────────────────────────────────────────── #
# Options: claude, openai_codex, gemini
llm_provider = claude

# ── Claude ──────────────────────────────────────────────────────────── #
# Install: npm install -g @anthropic-ai/claude-code
claude_binary = ~/.local/bin/claude
claude_timeout = 900

# ── OpenAI Codex (optional) ─────────────────────────────────────────── #
# openai_binary = /usr/local/bin/codex
# openai_timeout = 120
# openai_model = gpt-4o

# ── Google Gemini (optional) ────────────────────────────────────────── #
# gemini_binary = /usr/local/bin/gemini
# gemini_timeout = 120
# gemini_model = gemini-2.5-flash

# ── Daemon ──────────────────────────────────────────────────────────── #
log_file = {{RELAY_HOME}}/logs/relay.log
pid_file = /tmp/relay-{{RELAY_NAME}}.pid
session_file = {{RELAY_HOME}}/data/sessions.json
session_expiry_hours = 24
photo_dir = {{RELAY_HOME}}/data/.telegram-photos
transcript_dir = {{RELAY_HOME}}/data/transcripts

# ── Memory Search (optional — install with --with-memory) ─────────── #
memory_search_enabled = {{MEMORY_SEARCH_ENABLED}}
# memory_search_top_k = 3
# memory_search_threshold = 0.5
# memory_search_url = http://localhost:8765/search

# ── Memory Sidecar Lifecycle ────────────────────────────────────────── #
memory_service_url = http://localhost:8765
memory_service_autostart = {{MEMORY_SERVICE_AUTOSTART}}
memory_service_script = {{RELAY_HOME}}/apps/memory-py/memory_http.py
# memory_service_watch_interval_ms = 30000
# memory_ingest_interval_sec = 300
# memory_transcript_ingest_interval_sec = 1800

# ── Agent Bus (inter-agent communication) ─────────────────────────── #
agent_bus_enabled = 1
agent_bus_socket = {{RELAY_HOME}}/data/relay.sock
agent_bus_rate_limit = 10
agent_bus_max_depth = 3

# ── Workspace Definitions ──────────────────────────────────────────── #
# Each workspace is a directory the agent can be sent into.
# Use /session <name> in Telegram to switch between workspaces.
# Add as many blocks as you need — one per project.

[workspace "{{WORKSPACE_NAME}}"]
path = {{WORKSPACE_PATH}}
provider = {{WORKSPACE_PROVIDER}}

# Example additional workspace:
# [workspace "myapp"]
# path = ~/Code/myapp
# provider = codex

# Another example:
# [workspace "research"]
# path = ~/Documents/research
# provider = gemini

